# Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=generate_a_secure_random_jwt_secret_64_chars
ALLOWED_ORIGINS=https://medassist-ai.vercel.app

# Database Configuration (PostgreSQL / Supabase / Neon / Render)
DATABASE_URL=postgresql://user:password@host:5432/medassist_db?sslmode=require

# Microservices
FASTAPI_OCR_URL=https://medassist-fastapi.onrender.com

# SMTP Configuration (Nodemailer / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# Frontend App URL
APP_URL=https://medassist-ai.vercel.app

# Optional AI / Telegram Integrations
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MedAssistAIBot
